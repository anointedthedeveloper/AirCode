<Application x:Class="AirCode.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AirCode.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Views/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <conv:ConnectionStateToColorConverter x:Key="ConnStateToColor"/>
            <conv:TransferStatusToColorConverter x:Key="TransferStatusToColor"/>
            <conv:PageEqualityConverter x:Key="PageEq"/>
            <conv:TransferDirectionConverter x:Key="TransferDir"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
            <conv:InverseBoolConverter x:Key="InvBool"/>
            <conv:StringToInitialsConverter x:Key="ToInitials"/>
            <conv:IsConnectingConverter x:Key="IsConnecting"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
