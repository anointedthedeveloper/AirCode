<UserControl x:Class="AirCode.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Live diagnostics — useful for troubleshooting hotspot and network issues."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE8C8;  Copy All" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Padding="12,8" Click="CopyAll_Click"
                        ToolTip="Copy entire log to clipboard">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="12,8"
                        Click="Clear_Click" ToolTip="Clear log">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filter:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="FilterAll"     Content="All"     Style="{StaticResource SecondaryButton}"
                    Padding="10,5" FontSize="12" Margin="0,0,4,0" Click="Filter_Click" Tag="All"/>
            <Button x:Name="FilterInfo"    Content="Info"    Style="{StaticResource SecondaryButton}"
                    Padding="10,5" FontSize="12" Margin="0,0,4,0" Click="Filter_Click" Tag="Info"/>
            <Button x:Name="FilterWarning" Content="Warning" Style="{StaticResource SecondaryButton}"
                    Padding="10,5" FontSize="12" Margin="0,0,4,0" Click="Filter_Click" Tag="Warning"/>
            <Button x:Name="FilterError"   Content="Error"   Style="{StaticResource SecondaryButton}"
                    Padding="10,5" FontSize="12" Margin="0,0,4,0" Click="Filter_Click" Tag="Error"/>
            <Button x:Name="FilterSuccess" Content="Success" Style="{StaticResource SecondaryButton}"
                    Padding="10,5" FontSize="12" Click="Filter_Click" Tag="Success"/>
        </StackPanel>

        <!-- Log entries -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="LogScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogList" Margin="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" Padding="12,7,8,7">
                                    <TextBlock Text="{Binding TimeText}"
                                               FontFamily="Consolas" FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BgBrush}"
                                        Padding="0,7,8,7">
                                    <TextBlock Text="{Binding LevelText}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding LevelColor}"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource BgBrush}"
                                        Padding="0,7,8,7">
                                    <TextBlock Text="{Binding Category}" FontSize="11.5"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Consolas"/>
                                </Border>
                                <Border Grid.Column="3" Background="{StaticResource BgBrush}"
                                        Padding="0,7,12,7">
                                    <TextBlock Text="{Binding Message}" FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <!-- Copy single line -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource GhostButton}"
                                        Padding="8,4" Tag="{Binding}"
                                        Click="CopyLine_Click"
                                        ToolTip="Copy this line"
                                        Visibility="Hidden">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
