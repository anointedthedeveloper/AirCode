<UserControl x:Class="AirCode.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Thread list -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHATS" Style="{StaticResource Label}" Margin="16,16,16,8"/>
                <ScrollViewer Style="{StaticResource MinimalScroll}">
                    <StackPanel x:Name="ThreadList" Margin="8,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right: Message area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,14" Background="{StaticResource SurfaceBrush}">
                <TextBlock x:Name="ChatHeaderText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Text="Classroom Chat"/>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="1" x:Name="MsgScroll" Style="{StaticResource MinimalScroll}"
                          Padding="20,12">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <!-- Own messages (right-aligned) -->
                                <Border HorizontalAlignment="Right" MaxWidth="460"
                                        Background="{StaticResource OwnMessageBrush}"
                                        BorderBrush="{StaticResource OwnMessageBorderBrush}"
                                        BorderThickness="1" CornerRadius="10,10,2,10"
                                        Padding="12,8"
                                        Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="10" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Other messages (left-aligned) -->
                                <StackPanel HorizontalAlignment="Left" MaxWidth="460"
                                            Visibility="{Binding IsOwn, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Border Background="{StaticResource OtherMessageBrush}"
                                            BorderBrush="{StaticResource OtherMessageBorderBrush}"
                                            BorderThickness="1" CornerRadius="10,10,10,2" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,12" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput" Style="{StaticResource InputBox}"
                             FontSize="13" Padding="12,10"
                             KeyDown="Input_KeyDown"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="False"/>
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="20,10" Click="Send_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
