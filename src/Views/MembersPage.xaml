<UserControl x:Class="AirCode.Views.MembersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Members" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="CountText" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Member List -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource MinimalScroll}">
            <ItemsControl x:Name="MemberList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource PrimaryGradient}">
                                    <TextBlock Text="{Binding Initials}" FontSize="13"
                                               FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                Background="#EFF6FF"
                                                Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Host" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Status + Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#22C55E"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Online" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="MsgBtn" Content="Message" Tag="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" FontSize="12"
                                            Click="Message_Click" Margin="0,0,6,0"/>
                                    <Button Content="Send File" Tag="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" FontSize="12"
                                            Click="SendFile_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
