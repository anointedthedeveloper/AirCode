<Window x:Class="AirCode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirCode.Views"
        Title="AirCode" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        Icon="/aircode.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════
             SIDEBAR
        ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <!-- Logo / Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Image Source="/logo.png" Width="30" Height="30" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="AirCode" FontSize="19" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <TextBlock Text="Share code. Stay local." FontSize="10.5"
                               Foreground="#475569" Margin="40,0,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- Connection status badge -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,14"
                        Background="#0A1628" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status dot -->
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToColor}}"
                                 Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding ConnectionStatusDetail}"
                                       FontSize="10" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Connecting spinner -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Spinner}"
                                Width="14" Height="14"
                                BorderThickness="2"
                                Margin="6,0,0,0"
                                Visibility="{Binding ConnectionState,
                                    Converter={StaticResource IsConnecting}}"/>
                    </Grid>
                </Border>

                <!-- Nav separator label -->
                <TextBlock DockPanel.Dock="Top" Text="NAVIGATION"
                           FontSize="9.5" FontWeight="SemiBold"
                           Foreground="#334155" Margin="18,0,0,6"
                           FontFamily="Segoe UI"/>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top">
                    <!-- Home -->
                    <Button x:Name="NavHome" Click="Nav_Home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Members -->
                    <Button x:Name="NavMembers" Click="Nav_Members">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Members" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Chat -->
                    <Button x:Name="NavChat" Click="Nav_Chat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Files -->
                    <Button x:Name="NavFiles" Click="Nav_Files">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Code -->
                    <Button x:Name="NavCode" Click="Nav_Code">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Transfers -->
                    <Button x:Name="NavTransfers" Click="Nav_Transfers">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Transfers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Logs -->
                    <Button x:Name="NavLogs" Click="Nav_Logs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: Settings -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Border Height="1" Background="#1E293B" Margin="12,6"/>
                    <Button x:Name="NavSettings" Click="Nav_Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}"/>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             CONTENT AREA
        ═══════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
            <views:HomePage      x:Name="HomePage"      Visibility="Visible"/>
            <views:MembersPage   x:Name="MembersPage"   Visibility="Collapsed"/>
            <views:ChatPage      x:Name="ChatPage"       Visibility="Collapsed"/>
            <views:FilesPage     x:Name="FilesPage"      Visibility="Collapsed"/>
            <views:CodePage      x:Name="CodePage"       Visibility="Collapsed"/>
            <views:TransfersPage x:Name="TransfersPage"  Visibility="Collapsed"/>
            <views:LogPage       x:Name="LogPage"         Visibility="Collapsed"/>
            <views:SettingsPage  x:Name="SettingsPage"    Visibility="Collapsed"/>
        </Grid>

        <!-- Toast overlay -->
        <views:ToastHost x:Name="ToastHost" Grid.Column="1"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         Margin="0,0,20,20" Panel.ZIndex="100"
                         IsHitTestVisible="False"/>
    </Grid>
</Window>
