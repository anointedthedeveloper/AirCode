<Window x:Class="AirCode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AirCode.Views"
        xmlns:vm="clr-namespace:AirCode.ViewModels"
        Title="AirCode" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="/aircode.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo / Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Image Source="/logo.png" Width="28" Height="28" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AirCode" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Share code. Stay local." FontSize="10"
                               Foreground="#64748B" Margin="36,0,0,0"/>
                </StackPanel>

                <!-- Connection Status Badge -->
                <Border DockPanel.Dock="Top" Margin="12,4,12,12"
                        Background="#0F2027" CornerRadius="6" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToColor}}"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{Binding ConnectionStatusDetail}" FontSize="10"
                                       Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nav Items -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0">
                    <Button Style="{StaticResource NavButton}" Click="Nav_Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="14" Width="20"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Members">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" FontSize="14" Width="20"/>
                            <TextBlock Text="Members" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✉" FontSize="14" Width="20"/>
                            <TextBlock Text="Chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Files">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇪" FontSize="14" Width="20"/>
                            <TextBlock Text="Files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Code">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xFE69;" FontSize="14" Width="20"/>
                            <TextBlock Text="Code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Transfers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="14" Width="20"/>
                            <TextBlock Text="Transfers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: Settings -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                    <Separator Background="#1E3A5F" Margin="4,8"/>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Width="20"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid/><!-- fill -->
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
            <!-- Pages (switched via Visibility) -->
            <views:HomePage    x:Name="HomePage"    Visibility="Visible"/>
            <views:MembersPage x:Name="MembersPage" Visibility="Collapsed"/>
            <views:ChatPage    x:Name="ChatPage"    Visibility="Collapsed"/>
            <views:FilesPage   x:Name="FilesPage"   Visibility="Collapsed"/>
            <views:CodePage    x:Name="CodePage"    Visibility="Collapsed"/>
            <views:TransfersPage x:Name="TransfersPage" Visibility="Collapsed"/>
            <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>

        <!-- Toast notification overlay -->
        <views:ToastHost x:Name="ToastHost" Grid.Column="1"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         Margin="0,0,20,20" Panel.ZIndex="100"/>
    </Grid>
</Window>
