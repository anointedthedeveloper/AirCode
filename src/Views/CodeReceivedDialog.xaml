<Window x:Class="AirCode.Views.CodeReceivedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Received" Height="Auto" Width="600"
        SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SubText" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{StaticResource InputBgBrush}" Margin="0,0,0,12">
            <TextBox x:Name="CodeBox" Background="Transparent"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas, Courier New" FontSize="13"
                     IsReadOnly="True" AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Padding="16" TextWrapping="NoWrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy to Clipboard" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
