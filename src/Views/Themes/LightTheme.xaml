<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AirCode Brand Colors -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="SecondaryColor">#06B6D4</Color>
    <Color x:Key="DarkColor">#0F172A</Color>
    <Color x:Key="AccentColor">#38BDF8</Color>

    <!-- Light Theme Surface Colors -->
    <Color x:Key="BgColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#1E293B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="HoverColor">#F1F5F9</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BgBrush"             Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"        Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="HoverBrush"          Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"        Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"    Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SidebarActiveText"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OwnMessageBrush"     Color="#EFF6FF"/>
    <SolidColorBrush x:Key="OtherMessageBrush"   Color="#F8FAFC"/>
    <SolidColorBrush x:Key="OwnMessageBorderBrush"   Color="#BFDBFE"/>
    <SolidColorBrush x:Key="OtherMessageBorderBrush" Color="#E2E8F0"/>

    <!-- Gradient for primary buttons -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
