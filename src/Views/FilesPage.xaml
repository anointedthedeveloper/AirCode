<UserControl x:Class="AirCode.Views.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Send Files" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Share files with anyone on the AirCode network." FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Recipient + Drop Zone -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <!-- Recipient selector -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="SEND TO" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="RecipientCombo" FontSize="13" Height="38"
                              Background="{StaticResource InputBgBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Drop zone -->
                <Border x:Name="DropZone" BorderThickness="2" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}"
                        Background="{StaticResource BgBrush}"
                        MinHeight="120" Padding="20"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⇪" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Drop files here" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="or" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Button Content="Choose Files" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center" Click="ChooseFiles_Click"/>
                    </StackPanel>
                </Border>

                <!-- Selected files list -->
                <ItemsControl x:Name="SelectedFilesList" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                        Tag="{Binding}" Padding="4" Click="RemoveFile_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Send button -->
                <Button x:Name="SendBtn" Content="Send Files" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Margin="0,12,0,0" Padding="24,10"
                        Click="Send_Click"/>
            </StackPanel>
        </Border>

        <!-- Active transfers -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVE TRANSFERS" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                <ScrollViewer Style="{StaticResource MinimalScroll}">
                    <ItemsControl x:Name="ActiveTransferList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12"
                                        Background="{StaticResource BgBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Direction, Converter={StaticResource TransferDir}}"
                                                           FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                                           Margin="0,0,8,0" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryBrush}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                                     Margin="0,0,0,4"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="{StaticResource BorderBrush}"/>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
