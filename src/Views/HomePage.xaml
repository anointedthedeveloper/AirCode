<UserControl x:Class="AirCode.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer Style="{StaticResource MinimalScroll}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="AirCode network overview" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Network Status Card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToColor}}"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConnectionStatusDetail}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="HostIpText" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Host/Connect buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartHostBtn" Content="Start Network" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Click="StartHost_Click"/>
                        <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource SecondaryButton}"
                                Click="Connect_Click"/>
                        <Button x:Name="DisconnectBtn" Content="Disconnect" Style="{StaticResource DangerButton}"
                                Visibility="Collapsed" Click="Disconnect_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Action Buttons -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,24">
                <Button Content="⇪  Send File" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8" Padding="16,10" Click="SendFile_Click"/>
                <Button Content="&#xFE69;  Share Code" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8" Padding="16,10" Click="ShareCode_Click"/>
                <Button Content="✉  Open Chat" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,8" Padding="16,10" Click="OpenChat_Click"/>
            </WrapPanel>

            <!-- Recent Activity -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ActivityList" ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No activity yet — connect to an AirCode network to get started."
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,20"
                               Visibility="{Binding RecentActivity.Count, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
