<Window x:Class="AirCode.Views.HostSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create AirCode Network" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="28">

        <!-- Buttons pinned to the bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Start Network" Style="{StaticResource PrimaryButton}"
                    Padding="20,10" Click="Start_Click"/>
        </StackPanel>

        <!-- Content scrolls above the buttons -->
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Create AirCode Network" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Other computers will connect to this network." FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Network name -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="NETWORK NAME" Style="{StaticResource Label}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"/>
            </StackPanel>

            <!-- Password with show/hide toggle -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="PASSWORD" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="PassBox"
                                 Padding="10,9" FontSize="13"
                                 Background="{StaticResource InputBgBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1,1,0,1"/>

                    <!-- Plain-text fallback (hidden by default) -->
                    <TextBox x:Name="PassText"
                             Style="{StaticResource InputBox}"
                             Visibility="Collapsed"
                             BorderThickness="1,1,0,1"
                             FontSize="13"/>

                    <!-- Toggle button -->
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="0,6,6,0"
                            Background="{StaticResource InputBgBrush}">
                        <Button x:Name="TogglePassBtn"
                                Width="38" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Show / hide password"
                                Click="TogglePass_Click">
                            <TextBlock x:Name="TogglePassIcon" Text="👁" FontSize="14"/>
                        </Button>
                    </Border>
                </Grid>
                <TextBlock Text="Minimum 8 characters" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Note: Hotspot creation requires administrator privileges and a compatible Wi-Fi adapter. AirCode will fall back to your existing network if the hotspot cannot be created."/>
        </StackPanel>
    </DockPanel>
</Window>
