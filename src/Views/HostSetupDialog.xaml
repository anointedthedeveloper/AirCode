<Window x:Class="AirCode.Views.HostSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start AirCode Network" Height="Auto" Width="460"
        SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="28">

        <!-- Buttons pinned to bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Start Hosting" Style="{StaticResource PrimaryButton}"
                    Padding="20,10" Click="Start_Click"/>
        </StackPanel>

        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Start AirCode Network" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                <TextBlock Text="Other devices connect to this PC through its hotspot."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- How it works -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <TextBlock Text="1.  Connect this PC to Wi-Fi (the internet or school network)" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="2.  AirCode turns this PC into a Wi-Fi hotspot" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="3.  Everyone else joins that hotspot and taps Connect in AirCode" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Hotspot settings -->
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <CheckBox x:Name="UseHotspotBox" IsChecked="True" Checked="Hotspot_Toggled" Unchecked="Hotspot_Toggled"
                              Content="Share this PC's Wi-Fi as a hotspot (recommended)"
                              FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="HotspotFields">
                        <TextBlock Text="NETWORK NAME" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SsidBox" Style="{StaticResource InputBox}" MaxLength="32" Margin="0,0,0,10"/>
                        <TextBlock Text="PASSWORD (8+ characters)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PasswordBox" Style="{StaticResource InputBox}" MaxLength="63"/>
                    </StackPanel>
                    <TextBlock x:Name="NoHotspotText" Visibility="Collapsed" TextWrapping="Wrap"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"
                               Text="Hosting on the Wi-Fi you are already connected to. Other devices must join that same network."/>
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12" Foreground="#EF4444" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
