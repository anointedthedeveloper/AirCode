<Window x:Class="AirCode.Views.HostSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start AirCode Network" Height="Auto" Width="460"
        SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="28">

        <!-- Buttons pinned to bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Start Hosting" Style="{StaticResource PrimaryButton}"
                    Padding="20,10" Click="Start_Click"/>
        </StackPanel>

        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Start AirCode Network" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                <TextBlock Text="Other computers will connect to this host."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Step 1 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Connect all PCs to the same Wi-Fi" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <TextBlock Text="Use your phone hotspot, Windows Mobile Hotspot, or any router.&#x0a;All devices must be on the same network." FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="32,0,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Step 2 — detected IP -->
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AirCode will host on your current network"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <StackPanel Margin="32,0,0,0">
                        <TextBlock x:Name="AdapterText" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Host IP:" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="IpText" FontSize="13" FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="NoNetworkText"
                                   Text="⚠ No network detected. Connect to Wi-Fi first."
                                   FontSize="12" Foreground="#EF4444"
                                   Visibility="Collapsed" Margin="0,6,0,0"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
